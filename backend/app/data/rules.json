    {
      "rule_id": "P60177",
      "sutra": "6.1.77",
      "name": "iko yaṇaci",
      "sutra_devanagari": "इको यणचि",
      "description": "An ik vowel is replaced by its corresponding yaṇ sound when followed by a vowel in saṃhitā.",
      "phenomenon": "vowel_sandhi",
      "priority": 100,
      "status": "validated_subset",
      "enabled": true,
      "repeatable": false,

      "conditions": [
        {
          "condition_type": "context_pair",
          "left_class": "ik",
          "right_class": "ac",
          "metadata": {
            "requires_adjacent_tokens": true
          }
        }
      ],

      "operations": [
        {
          "operation_type": "contextual_substitute",
          "mapping": {
            "इ": "य",
            "ई": "य",
            "उ": "व",
            "ऊ": "व",
            "ऋ": "र",
            "ॠ": "र",
            "ऌ": "ल"
          },
          "target": "left_token"
        }
      ],

      "scope": {
        "domains": [
          "phonology",
          "sandhi",
          "vowel_sandhi"
        ],
        "categories": [
          "ac"
        ],
        "required_features": {},
        "excluded_features": {}
      },

      "dependencies": [
        "P601101"
      ],

      "blocking_type": "blocked_by",
      "blocks": [],
      "blocked_by": [
        "P601101"
      ],

      "examples": [
        {
          "input": "दधि + अत्र",
          "expected_output": "दध्यत्र"
        },
        {
          "input": "मधु + अत्र",
          "expected_output": "मध्वत्र"
        }
      ],

      "metadata": {
        "source_status": "verified_sutra_subset",
        "phase": "2",
        "domain": "ac_sandhi"
      }
    },

